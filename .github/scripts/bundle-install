#!/usr/bin/env bash

set -o pipefail

cd "${1:-.}" || exit 10

for attempt in 1 2 3; do
  if jruby -S bundle install --jobs 3 --retry 5; then
    exit 0
  fi

  if [ "$attempt" -eq 3 ]; then
    exit 12
  fi

  delay=$((attempt * 15))
  echo "bundle install failed; retrying in ${delay}s (attempt $((attempt + 1))/3)"
  sleep "$delay"
done
